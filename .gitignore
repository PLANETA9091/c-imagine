# Rust
/target/
**/*.rs.bk
cargo-timing*.html

# Java / Gradle
.gradle/
*.class
java/cim-bootstrap/build/
/test-mods/build/
/scene-mod/build/
/live-mod/build/

# Vendored CRUSSTY SDK ships prebuilt bytecode helpers — keep them.
# NOTE: negation only works when no parent dir is ignored, hence the
# anchored /dist/ and /target/ patterns below.
!third_party/**/*.class

# CI artifacts and local probe output (AGENTS.md: artifacts only, never committed)
/ci-artifacts/
/probe-out/

# Paper / server runtime artifacts (never commit)
run/
srv/
eula.txt
server.properties
logs/
crash-reports/
usercache.json
*.log

# Module packaging output
/dist/

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Keep the embedded bootstrap placeholder tracked, but ignore real jars
# dropped into embedded/ by local tooling (CI overwrites it deliberately).
paper-plugin/target/

# Excluded-crates keep their own target dirs out of git.
third_party/*/target/
artifacts-srvcheck/
artifacts-loc/
scripts/truth/__pycache__/
scripts/**/__pycache__/
__pycache__/
/paper-plugin/build/

# Generated gallery/pack model dumps must never live in the plugin's source
# resources (the offline build jars the whole folder); the pack emits into
# its own zip at runtime.
paper-plugin/src/main/resources/assets/

# CI/runtime workspaces (never commit — a checked-in srv-wall/ makes
# `cp -r layer-srv srv-wall` nest the layer INSIDE the existing dir and
# the server can't find its args file — measured #40)
/srv-wall/
/srv-ours/
/ours-shots/
/truth-shots/
/seed-pack/
/nfc/
/truth-client/
/visual-client/
/layer-srv/
/mods-create/
/vtools/

# local GH credentials (never commit)
/.secrets/

# Session working artifacts (the e-era strays, the AGENTS.md law: artifacts only, never committed)
/*.zip
/entity_pair.png
/truth-shots/
/ours-shots/
/visual-client/
/srv-wall/
/vtools/
/*.log
