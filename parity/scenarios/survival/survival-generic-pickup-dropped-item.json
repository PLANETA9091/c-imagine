    "fill 304 121 304 316 130 316 minecraft:air",
    "give {player} create:andesite_alloy 3"
  ],
  "steps": [
    {
      "do": "select",
      "item": "create:andesite_alloy"
    },
    {
      "do": "tp",
      "pos": [
        308.5,
        121,
        308.5
      ],
      "yaw": 0.0,
      "pitch": 0.0
    },
    {
      "do": "key",
      "key": "key.drop",
      "ticks": 1
    },
    {
      "do": "wait",
      "ticks": 20
    },
    {
      "do": "collect",
      "pos": [
        308,
        121,
        310
      ]
    },
    {
      "do": "wait",
      "ticks": 20
    },
    {
      "observe": "inventory"
    }
  ]
}
