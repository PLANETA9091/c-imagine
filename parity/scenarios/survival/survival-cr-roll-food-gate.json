        308.5
      ],
      "yaw": 0.0,
      "pitch": 0.0
    },
    {
      "do": "wait",
      "ticks": 20
    },
    {
      "observe": "motion"
    },
    {
      "do": "key",
      "key": "keybinds.combat_roll.roll",
      "ticks": 1
    },
    {
      "do": "wait",
      "ticks": 20
    },
    {
      "observe": "motion"
